# ============================================================================
# Enterprise HR Compliance Bot - environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` file to version control.
# ============================================================================

# --- Google Gemini ---
# Required for real embeddings + answer generation.
# Obtainable from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Chat / generation model used by the RAG pipeline.
GEMINI_MODEL=gemini-2.0-flash

# Embedding model used to vectorize document chunks and queries.
EMBEDDING_MODEL=models/text-embedding-004

# Embeddings provider.
#   gemini -> Google Generative AI embeddings (requires GOOGLE_API_KEY)
#   dummy  -> deterministic local hash-based embeddings (offline dev / tests ONLY)
EMBEDDINGS_PROVIDER=gemini

# LLM provider used to generate answers.
#   gemini -> Google Gemini chat model (requires GOOGLE_API_KEY)
#   dummy  -> deterministic offline mock (offline dev / tests ONLY)
LLM_PROVIDER=gemini

# --- Storage ---
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=hr_compliance_docs
DOCUMENTS_DIRECTORY=data/documents

# --- Retrieval ---
# Number of candidate chunks retrieved from the vector store.
TOP_K=5
# Minimum relevance score (0..1) for a chunk to be used as grounding context.
# Chunks below this threshold are discarded and the bot will say it has
# insufficient information rather than guessing.
SIMILARITY_THRESHOLD=0.55

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Request validation ---
MAX_QUESTION_LENGTH=500
MAX_UPLOAD_SIZE_MB=50

# --- Users database (PostgreSQL in production) ---
# PostgreSQL example (requires the psycopg driver, already in requirements):
# DATABASE_URL=postgresql://hrbot:CHANGE_ME@localhost:5432/hrbot
# Local SQLite fallback for development (no server needed):
DATABASE_URL=sqlite:///./data/app.db

# --- JWT authentication ---
# Generate a strong random value for production, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480